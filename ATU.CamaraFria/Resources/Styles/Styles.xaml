<?xml version="1.0" encoding="UTF-8" ?>
<!--
    ════════════════════════════════════════════════════════════════════════
    STYLES.XAML — Estilos theme-aware.

    Cada Setter que define un color usa AppThemeBinding con los pares
    ColorXxx (Dark) y ColorXxxLight definidos en Theme.xaml. Esto es válido
    porque <Setter Value="..."> sí acepta markup extensions y BindingBase.
    ════════════════════════════════════════════════════════════════════════-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--  ═══════════════ TIPOGRAFÍA ═══════════════  -->
    <Style x:Key="TitleLabel" TargetType="Label">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight}, Dark={StaticResource ColorTextPrimary}}" />
    </Style>

    <Style x:Key="SubtitleLabel" TargetType="Label">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ColorTextSecondaryLight}, Dark={StaticResource ColorTextSecondary}}" />
    </Style>

    <Style x:Key="CaptionLabel" TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ColorTextMutedLight}, Dark={StaticResource ColorTextMuted}}" />
    </Style>

    <Style x:Key="HeaderLabel" TargetType="Label">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight}, Dark={StaticResource ColorTextPrimary}}" />
    </Style>

    <Style x:Key="OtpCodeLabel" TargetType="Label">
        <Setter Property="FontSize" Value="88" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ColorSuccessLight}, Dark={StaticResource ColorSuccess}}" />
        <Setter Property="CharacterSpacing" Value="18" />
        <Setter Property="HorizontalOptions" Value="Center" />
    </Style>

    <Style x:Key="CountdownLabel" TargetType="Label">
        <Setter Property="FontSize" Value="52" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ColorErrorLight}, Dark={StaticResource ColorError}}" />
        <Setter Property="HorizontalOptions" Value="End" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="StatusLabel" TargetType="Label">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
    </Style>

    <!--  ═══════════════ CONTENEDORES ═══════════════  -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource ColorSurfaceLight}, Dark={StaticResource ColorSurface}}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 18" />
        <Setter Property="Padding" Value="18" />
    </Style>

    <Style x:Key="InputContainer" TargetType="Border">
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource ColorSurfaceSoftLight}, Dark={StaticResource ColorSurfaceSoft}}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource ColorBorderInputLight}, Dark={StaticResource ColorBorderInput}}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Padding" Value="14,4" />
    </Style>

    <Style x:Key="BorderPrimary" TargetType="Border">
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource ColorPrimaryLight}, Dark={StaticResource ColorPrimary}}" />
        <Setter Property="StrokeThickness" Value="2.5" />
        <Setter Property="StrokeShape" Value="RoundRectangle 14" />
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource ColorSurfaceSoftLight}, Dark={StaticResource ColorSurfaceSoft}}" />
    </Style>

    <Style x:Key="BorderSuccess" TargetType="Border">
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource ColorSuccessLight}, Dark={StaticResource ColorSuccess}}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ColorSurfaceSuccessLight}, Dark={StaticResource ColorSurfaceSuccess}}" />
    </Style>

    <Style x:Key="BorderWarning" TargetType="Border">
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource ColorWarningLight}, Dark={StaticResource ColorWarning}}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource ColorSurfaceLight}, Dark={StaticResource ColorSurface}}" />
    </Style>

    <Style x:Key="BorderError" TargetType="Border">
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource ColorErrorLight}, Dark={StaticResource ColorError}}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ColorSurfaceDangerLight}, Dark={StaticResource ColorSurfaceDanger}}" />
    </Style>

    <!--  ═══════════════ INPUTS ═══════════════  -->
    <Style x:Key="EntryStyle" TargetType="Entry">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight}, Dark={StaticResource ColorTextPrimary}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource ColorPlaceholderLight}, Dark={StaticResource ColorPlaceholder}}" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!--  ═══════════════ BOTONES ═══════════════  -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ColorPrimaryLight}, Dark={StaticResource ColorPrimary}}" />
        <Setter Property="TextColor" Value="#FFFFFF" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="HeightRequest" Value="56" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ColorBorderDefaultLight}, Dark={StaticResource ColorBorderDefault}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight}, Dark={StaticResource ColorTextPrimary}}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="DangerButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ColorSurfaceDangerSoftLight}, Dark={StaticResource ColorSurfaceDangerSoft}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ColorErrorLight}, Dark={StaticResource ColorError}}" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="HeightRequest" Value="56" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style x:Key="SmallActionButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ColorPrimaryLight}, Dark={StaticResource ColorPrimary}}" />
        <Setter Property="TextColor" Value="#FFFFFF" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="Padding" Value="20,0" />
    </Style>

    <Style x:Key="WarningButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ColorWarningLight}, Dark={StaticResource ColorWarning}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ColorTextOnWarningLight}, Dark={StaticResource ColorTextOnWarning}}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HeightRequest" Value="54" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!--  ═══════════════ LOADING ═══════════════  -->
    <Style x:Key="PrimaryLoader" TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource ColorPrimaryLight}, Dark={StaticResource ColorPrimary}}" />
        <Setter Property="HorizontalOptions" Value="Center" />
    </Style>

    <!--  ═══════════════ SEPARADORES ═══════════════  -->
    <Style x:Key="Divider" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource ColorBorderDefaultLight}, Dark={StaticResource ColorBorderDefault}}" />
    </Style>

</ResourceDictionary>
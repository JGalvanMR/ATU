<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="30dp"
    android:background="#070B18">

	<TextView
        android:id="@+id/txtProducto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Producto: ---"
        android:textSize="20sp"
        android:textColor="#00D4FF"
        android:gravity="center"
        android:layout_marginBottom="10dp"/>

	<TextView
        android:id="@+id/txtDetalle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Recibo: ---\nTarima: ---\nCaduca: ---"
        android:textSize="16sp"
        android:textColor="#5A7FA8"
        android:gravity="center"
        android:layout_marginBottom="30dp"/>

	<TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CÓDIGO PARA EMBARQUES:"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:layout_marginBottom="20dp"/>

	<TextView
        android:id="@+id/txtOTP"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="------"
        android:textSize="120sp"
        android:textStyle="bold"
        android:textColor="#00D4FF"
        android:gravity="center"
        android:letterSpacing="0.2"
        android:background="#0D1525"
        android:padding="20dp"/>

	<TextView
        android:id="@+id/txtTimer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Válido por: 30s"
        android:textSize="28sp"
        android:textColor="#00FF88"
        android:gravity="center"
        android:layout_marginTop="20dp"/>

	<LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="40dp">

		<Button
            android:id="@+id/btnCerrar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CERRAR"
            android:layout_marginRight="10dp"
            android:backgroundTint="#5A7FA8"/>

		<Button
            android:id="@+id/btnGenerarNuevo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="NUEVO CÓDIGO"
            android:layout_marginLeft="10dp"
            android:backgroundTint="#00D4FF"/>

	</LinearLayout>

</LinearLayout>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ATU.CamaraFria.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodel="clr-namespace:ATU.CamaraFria.ViewModels"
    x:DataType="viewmodel:LoginViewModel"
    BackgroundColor="#070B18">

    <ScrollView>
        <Grid
            Padding="28"
            RowDefinitions="Auto,Auto,Auto,Auto"
            RowSpacing="0"
            VerticalOptions="Center">

            <!--  Logo  -->
            <VerticalStackLayout
                Grid.Row="0"
                Margin="0,0,0,36"
                Spacing="8">
                <Border
                    Padding="20"
                    BackgroundColor="#0D1525"
                    HorizontalOptions="Center"
                    Stroke="#00BFFF"
                    StrokeShape="RoundRectangle 24"
                    StrokeThickness="2">
                    <Label
                        FontSize="52"
                        HorizontalOptions="Center"
                        Text="❄️" />
                </Border>
                <Label
                    FontAttributes="Bold"
                    FontSize="26"
                    HorizontalOptions="Center"
                    Text="ATU · Cámara Fría"
                    TextColor="#00BFFF" />
                <Label
                    FontSize="13"
                    HorizontalOptions="Center"
                    Text="Autorización Transaccional Única"
                    TextColor="#5A7FA8" />
            </VerticalStackLayout>

            <!--  Formulario  -->
            <VerticalStackLayout Grid.Row="1" Spacing="14">

                <Label
                    FontSize="13"
                    Text="Número de empleado"
                    TextColor="#8AA0BC" />
                <Border
                    BackgroundColor="#0D1525"
                    Stroke="#1E3050"
                    StrokeShape="RoundRectangle 10">
                    <Entry
                        Margin="12,14"
                        FontSize="22"
                        HorizontalTextAlignment="Center"
                        Keyboard="Default"
                        MaxLength="10"
                        Placeholder="Ej: 12345"
                        PlaceholderColor="#3A5070"
                        Text="{Binding EmployeeNumber}"
                        TextColor="White" />
                </Border>

                <Label
                    FontSize="13"
                    Text="Contraseña"
                    TextColor="#8AA0BC" />
                <Border
                    BackgroundColor="#0D1525"
                    Stroke="#1E3050"
                    StrokeShape="RoundRectangle 10">
                    <Entry
                        Margin="12,14"
                        FontSize="18"
                        HorizontalTextAlignment="Center"
                        IsPassword="True"
                        Placeholder="Contraseña de autorización"
                        PlaceholderColor="#3A5070"
                        Text="{Binding Password}"
                        TextColor="White" />
                </Border>

                <!--  URL servidor (colapsable)  -->
                <Label
                    FontSize="12"
                    HorizontalOptions="Center"
                    Text="⚙ Configurar servidor"
                    TextColor="#3A5070">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleServerConfigCommand}" />
                    </Label.GestureRecognizers>
                </Label>

                <Border
                    BackgroundColor="#0D1525"
                    IsVisible="{Binding ShowServerConfig}"
                    Stroke="#1E3050"
                    StrokeShape="RoundRectangle 8">
                    <Entry
                        Margin="10,10"
                        FontSize="13"
                        Keyboard="Url"
                        Placeholder="http://192.168.x.x:5059"
                        PlaceholderColor="#3A5070"
                        Text="{Binding ServerUrl}"
                        TextColor="#00BFFF" />
                </Border>

                <Button
                    Margin="0,8,0,0"
                    BackgroundColor="#00BFFF"
                    Command="{Binding LoginCommand}"
                    CornerRadius="12"
                    FontAttributes="Bold"
                    FontSize="17"
                    HeightRequest="52"
                    IsEnabled="{Binding IsNotBusy}"
                    Text="Iniciar Sesión"
                    TextColor="Black" />

                <ActivityIndicator
                    HorizontalOptions="Center"
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    Color="#00BFFF" />

                <Label
                    FontSize="14"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    IsVisible="{Binding HasError}"
                    LineBreakMode="WordWrap"
                    Text="{Binding ErrorMessage}"
                    TextColor="#FF4444" />
            </VerticalStackLayout>

            <Label
                Grid.Row="3"
                Margin="0,24,0,0"
                FontSize="11"
                HorizontalOptions="Center"
                Text="Solo personal autorizado en Tb_Autoriza_OdeP"
                TextColor="#2A4060" />
        </Grid>
    </ScrollView>
</ContentPage>

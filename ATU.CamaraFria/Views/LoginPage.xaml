<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ATU.CamaraFria.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:viewmodel="clr-namespace:ATU.CamaraFria.ViewModels"
    Padding="{OnPlatform iOS='0,48,0,0',
                         Default='0,24,0,0'}"
    ios:Page.UseSafeArea="True"
    x:DataType="viewmodel:LoginViewModel"
    BackgroundColor="#070B18">

    <ScrollView>
        <VerticalStackLayout Padding="24,16" Spacing="28">

            <!--  LOGO / HEADER  -->
            <VerticalStackLayout HorizontalOptions="Center" Spacing="10">

                <Border
                    Padding="22"
                    BackgroundColor="#0F1724"
                    Stroke="#1E3A5F"
                    StrokeShape="RoundRectangle 44"
                    StrokeThickness="1.5">
                    <Label
                        FontSize="48"
                        HorizontalOptions="Center"
                        Text="❄️" />
                </Border>

                <Label
                    FontAttributes="Bold"
                    FontSize="26"
                    HorizontalOptions="Center"
                    Text="ATU · Cámara Fría"
                    TextColor="#0A84FF" />

                <Label
                    FontSize="15"
                    HorizontalOptions="Center"
                    Text="Autorización Transaccional Única"
                    TextColor="#8CA0C0" />
            </VerticalStackLayout>

            <!--  FORM CARD  -->
            <Border
                Padding="18"
                BackgroundColor="#0F1724"
                Stroke="#1E3A5F"
                StrokeShape="RoundRectangle 20"
                StrokeThickness="1.5">

                <VerticalStackLayout Spacing="16">

                    <!--  EMPLOYEE  -->
                    <VerticalStackLayout Spacing="6">
                        <Label
                            FontAttributes="Bold"
                            FontSize="15"
                            Text="Número de empleado"
                            TextColor="#FFFFFF" />

                        <Border
                            Padding="14,4"
                            BackgroundColor="#0A1120"
                            Stroke="#2A4A70"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="1">
                            <Entry
                                FontAttributes="Bold"
                                FontSize="20"
                                HeightRequest="48"
                                Keyboard="Numeric"
                                MaxLength="10"
                                Placeholder="Ej: 12345"
                                PlaceholderColor="#4A6080"
                                Text="{Binding EmployeeNumber}"
                                TextColor="#FFFFFF"
                                VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="#1E3050" />

                    <!--  PASSWORD  -->
                    <VerticalStackLayout Spacing="6">
                        <Label
                            FontAttributes="Bold"
                            FontSize="15"
                            Text="Contraseña"
                            TextColor="#FFFFFF" />

                        <Border
                            Padding="14,4"
                            BackgroundColor="#0A1120"
                            Stroke="#2A4A70"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="1">
                            <Entry
                                FontSize="18"
                                HeightRequest="48"
                                IsPassword="True"
                                Placeholder="Contraseña de autorización"
                                PlaceholderColor="#4A6080"
                                Text="{Binding Password}"
                                TextColor="#FFFFFF"
                                VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!--  SERVER CONFIG  -->
            <VerticalStackLayout Spacing="10">

                <Label
                    FontSize="15"
                    HorizontalOptions="Center"
                    Text="⚙ Configurar servidor"
                    TextColor="#5A8AC0">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleServerConfigCommand}" />
                    </Label.GestureRecognizers>
                </Label>

                <Border
                    Padding="14"
                    BackgroundColor="#0F1724"
                    IsVisible="{Binding ShowServerConfig}"
                    Stroke="#1E3A5F"
                    StrokeShape="RoundRectangle 16"
                    StrokeThickness="1.5">

                    <Entry
                        FontSize="16"
                        HeightRequest="44"
                        Keyboard="Url"
                        Placeholder="http://192.168.x.x:5001"
                        PlaceholderColor="#4A6080"
                        Text="{Binding ServerUrl}"
                        TextColor="#0A84FF" />
                </Border>

            </VerticalStackLayout>

            <!--  LOGIN BUTTON  -->
            <Button
                Padding="0"
                BackgroundColor="#0A84FF"
                Command="{Binding LoginCommand}"
                CornerRadius="16"
                FontAttributes="Bold"
                FontSize="18"
                HeightRequest="56"
                IsEnabled="{Binding IsNotBusy}"
                Text="Iniciar Sesión"
                TextColor="#FFFFFF">

                <Button.Shadow>
                    <Shadow
                        Brush="#0A84FF"
                        Opacity="0.35"
                        Radius="10"
                        Offset="0,4" />
                </Button.Shadow>
            </Button>

            <!--  LOADING  -->
            <ActivityIndicator
                HorizontalOptions="Center"
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                Color="#0A84FF" />

            <!--  ERROR  -->
            <Border
                Padding="14"
                BackgroundColor="#2A0A0A"
                IsVisible="{Binding HasError}"
                Stroke="#FF453A"
                StrokeShape="RoundRectangle 12"
                StrokeThickness="1.5">
                <Label
                    FontAttributes="Bold"
                    FontSize="15"
                    HorizontalTextAlignment="Center"
                    Text="{Binding ErrorMessage}"
                    TextColor="#FF453A" />
            </Border>

            <!--  FOOTER  -->
            <Label
                Margin="0,12,0,0"
                FontSize="13"
                HorizontalOptions="Center"
                Text="Solo personal autorizado en Tb_Autoriza_OdeP"
                TextColor="#5A7FA8" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ATU.CamaraFria.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:viewmodel="clr-namespace:ATU.CamaraFria.ViewModels"
    Padding="{OnPlatform iOS='0,24,0,0',
                         Default='0,12,0,12'}"
    ios:Page.UseSafeArea="True"
    x:DataType="viewmodel:LoginViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource ColorBackgroundLight},
                                      Dark={StaticResource ColorBackground}}">

    <ScrollView>
        <VerticalStackLayout Padding="24,16" Spacing="24">

            <!--  LOGO / HEADER  -->
            <VerticalStackLayout HorizontalOptions="Center" Spacing="5">

                <Border
                    Padding="11"
                    BackgroundColor="{AppThemeBinding Light={StaticResource ColorSurfaceLight},
                                                      Dark={StaticResource ColorSurface}}"
                    Stroke="{AppThemeBinding Light={StaticResource ColorBorderDefaultLight},
                                             Dark={StaticResource ColorBorderDefault}}"
                    StrokeShape="RoundRectangle 44"
                    StrokeThickness="1.5">
                    <Label
                        FontSize="48"
                        HorizontalOptions="Center"
                        Text="❄️" />
                </Border>

                <Label
                    FontAttributes="Bold"
                    FontSize="26"
                    HorizontalOptions="Center"
                    Text="ATU · Cámara Fría"
                    TextColor="{AppThemeBinding Light={StaticResource ColorPrimaryLight},
                                                Dark={StaticResource ColorPrimary}}" />

                <Label
                    FontSize="15"
                    HorizontalOptions="Center"
                    Text="Autorización Transaccional Única"
                    TextColor="{AppThemeBinding Light={StaticResource ColorTextSecondaryLight},
                                                Dark={StaticResource ColorTextSecondary}}" />
            </VerticalStackLayout>

            <!--  FORM CARD  -->
            <Border
                Padding="18"
                BackgroundColor="{AppThemeBinding Light={StaticResource ColorSurfaceLight},
                                                  Dark={StaticResource ColorSurface}}"
                Stroke="{AppThemeBinding Light={StaticResource ColorBorderDefaultLight},
                                         Dark={StaticResource ColorBorderDefault}}"
                StrokeShape="RoundRectangle 20"
                StrokeThickness="1.5">

                <VerticalStackLayout Spacing="16">

                    <!--  EMPLOYEE  -->
                    <VerticalStackLayout Spacing="6">
                        <Label
                            FontAttributes="Bold"
                            FontSize="15"
                            Text="Número de empleado"
                            TextColor="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight},
                                                        Dark={StaticResource ColorTextPrimary}}" />

                        <Border
                            Padding="14,4"
                            BackgroundColor="{AppThemeBinding Light={StaticResource ColorSurfaceInputLight},
                                                              Dark={StaticResource ColorSurfaceInput}}"
                            Stroke="{AppThemeBinding Light={StaticResource ColorBorderInputLight},
                                                     Dark={StaticResource ColorBorderInput}}"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="1">
                            <Entry
                                FontAttributes="Bold"
                                FontSize="20"
                                HeightRequest="48"
                                Keyboard="Numeric"
                                MaxLength="10"
                                Placeholder="Ej: 12345"
                                PlaceholderColor="{AppThemeBinding Light={StaticResource ColorPlaceholderLight},
                                                                   Dark={StaticResource ColorPlaceholder}}"
                                Text="{Binding EmployeeNumber}"
                                TextColor="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight},
                                                            Dark={StaticResource ColorTextPrimary}}"
                                VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource ColorBorderDefaultLight}, Dark={StaticResource ColorBorderDefault}}" />

                    <!--  PASSWORD  -->
                    <VerticalStackLayout Spacing="6">
                        <Label
                            FontAttributes="Bold"
                            FontSize="15"
                            Text="Contraseña"
                            TextColor="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight},
                                                        Dark={StaticResource ColorTextPrimary}}" />

                        <Border
                            Padding="14,4"
                            BackgroundColor="{AppThemeBinding Light={StaticResource ColorSurfaceInputLight},
                                                              Dark={StaticResource ColorSurfaceInput}}"
                            Stroke="{AppThemeBinding Light={StaticResource ColorBorderInputLight},
                                                     Dark={StaticResource ColorBorderInput}}"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="1">
                            <Entry
                                FontSize="18"
                                HeightRequest="48"
                                IsPassword="True"
                                Placeholder="Contraseña de autorización"
                                PlaceholderColor="{AppThemeBinding Light={StaticResource ColorPlaceholderLight},
                                                                   Dark={StaticResource ColorPlaceholder}}"
                                Text="{Binding Password}"
                                TextColor="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight},
                                                            Dark={StaticResource ColorTextPrimary}}"
                                VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Border>

            <!--  SERVER CONFIG  -->
            <VerticalStackLayout Spacing="10">

                <Label
                    FontSize="15"
                    HorizontalOptions="Center"
                    Text="⚙ Configurar servidor"
                    TextColor="{AppThemeBinding Light={StaticResource ColorTextSecondaryLight},
                                                Dark={StaticResource ColorTextSecondary}}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleServerConfigCommand}" />
                    </Label.GestureRecognizers>
                </Label>

                <Border
                    Padding="14"
                    BackgroundColor="{AppThemeBinding Light={StaticResource ColorSurfaceLight},
                                                      Dark={StaticResource ColorSurface}}"
                    IsVisible="{Binding ShowServerConfig}"
                    Stroke="{AppThemeBinding Light={StaticResource ColorBorderDefaultLight},
                                             Dark={StaticResource ColorBorderDefault}}"
                    StrokeShape="RoundRectangle 16"
                    StrokeThickness="1.5">

                    <Entry
                        FontSize="16"
                        HeightRequest="44"
                        Keyboard="Url"
                        Placeholder="http://192.168.x.x:5002"
                        PlaceholderColor="{AppThemeBinding Light={StaticResource ColorPlaceholderLight},
                                                           Dark={StaticResource ColorPlaceholder}}"
                        Text="{Binding ServerUrl}"
                        TextColor="{AppThemeBinding Light={StaticResource ColorPrimaryLight},
                                                    Dark={StaticResource ColorPrimary}}" />
                </Border>

            </VerticalStackLayout>

            <!--  LOGIN BUTTON  -->
            <Button
                Padding="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource ColorPrimaryLight},
                                                  Dark={StaticResource ColorPrimary}}"
                Command="{Binding LoginCommand}"
                CornerRadius="16"
                FontAttributes="Bold"
                FontSize="18"
                HeightRequest="56"
                IsEnabled="{Binding IsNotBusy}"
                Text="Iniciar Sesión"
                TextColor="#FFFFFF">

                <Button.Shadow>
                    <Shadow
                        Brush="{AppThemeBinding Light={StaticResource ColorPrimaryLight},
                                                Dark={StaticResource ColorPrimary}}"
                        Opacity="0.35"
                        Radius="10"
                        Offset="0,4" />
                </Button.Shadow>
            </Button>

            <!--  LOADING  -->
            <ActivityIndicator
                HorizontalOptions="Center"
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                Color="{AppThemeBinding Light={StaticResource ColorPrimaryLight},
                                        Dark={StaticResource ColorPrimary}}" />

            <!--  ERROR  -->
            <Border
                Padding="14"
                BackgroundColor="{AppThemeBinding Light={StaticResource ColorSurfaceDangerLight},
                                                  Dark={StaticResource ColorSurfaceDanger}}"
                IsVisible="{Binding HasError}"
                Stroke="{AppThemeBinding Light={StaticResource ColorErrorLight},
                                         Dark={StaticResource ColorError}}"
                StrokeShape="RoundRectangle 12"
                StrokeThickness="1.5">
                <Label
                    FontAttributes="Bold"
                    FontSize="15"
                    HorizontalTextAlignment="Center"
                    Text="{Binding ErrorMessage}"
                    TextColor="{AppThemeBinding Light={StaticResource ColorErrorLight},
                                                Dark={StaticResource ColorError}}" />
            </Border>

            <!--  FOOTER  -->
            <Label
                Margin="0,12,0,0"
                FontSize="13"
                HorizontalOptions="Center"
                Text="Solo personal autorizado en Tb_Autoriza_OdeP"
                TextColor="{AppThemeBinding Light={StaticResource ColorTextSecondaryLight},
                                            Dark={StaticResource ColorTextSecondary}}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
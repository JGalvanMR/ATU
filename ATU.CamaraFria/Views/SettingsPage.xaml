<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ATU.CamaraFria.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    Title="Configuración"
    Padding="{OnPlatform iOS='0,48,0,0',
                         Default='0,12,0,12'}"
    ios:Page.UseSafeArea="True"
    BackgroundColor="{AppThemeBinding Light={StaticResource ColorBackgroundLight},
                                      Dark={StaticResource ColorBackground}}">

    <ScrollView>
        <VerticalStackLayout Padding="10" Spacing="11">

            <!--  SESIÓN  -->
            <Label
                FontAttributes="Bold"
                FontSize="13"
                Text="SESIÓN ACTIVA"
                TextColor="{AppThemeBinding Light={StaticResource ColorTextSecondaryLight},
                                            Dark={StaticResource ColorTextSecondary}}" />

            <Border
                Padding="18"
                BackgroundColor="{AppThemeBinding Light={StaticResource ColorSurfaceLight},
                                                  Dark={StaticResource ColorSurface}}"
                StrokeShape="RoundRectangle 18"
                StrokeThickness="0">

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Label
                        Grid.Column="0"
                        FontSize="26"
                        Text="👤"
                        VerticalOptions="Center" />

                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label
                            x:Name="LblNombre"
                            FontAttributes="Bold"
                            FontSize="19"
                            TextColor="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight},
                                                        Dark={StaticResource ColorTextPrimary}}" />
                        <Label
                            x:Name="LblEmpleado"
                            FontSize="15"
                            TextColor="{AppThemeBinding Light={StaticResource ColorTextSecondaryLight},
                                                        Dark={StaticResource ColorTextSecondary}}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!--  APARIENCIA — NUEVO  -->
            <Label
                FontAttributes="Bold"
                FontSize="13"
                Text="APARIENCIA"
                TextColor="{AppThemeBinding Light={StaticResource ColorTextSecondaryLight},
                                            Dark={StaticResource ColorTextSecondary}}" />

            <Border
                Padding="18"
                BackgroundColor="{AppThemeBinding Light={StaticResource ColorSurfaceLight},
                                                  Dark={StaticResource ColorSurface}}"
                StrokeShape="RoundRectangle 18"
                StrokeThickness="0">

                <VerticalStackLayout Spacing="14">

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label
                                FontAttributes="Bold"
                                FontSize="15"
                                Text="Seguir al sistema"
                                TextColor="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight},
                                                            Dark={StaticResource ColorTextPrimary}}" />
                            <Label
                                FontSize="12"
                                Text="Cambia automáticamente con iOS / Android"
                                TextColor="{AppThemeBinding Light={StaticResource ColorTextSecondaryLight},
                                                            Dark={StaticResource ColorTextSecondary}}" />
                        </VerticalStackLayout>
                        <Switch
                            x:Name="SwitchFollowSystem"
                            Grid.Column="1"
                            IsToggled="True"
                            OnColor="{AppThemeBinding Light={StaticResource ColorSuccessLight},
                                                      Dark={StaticResource ColorSuccess}}"
                            Toggled="OnFollowSystemToggled" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource ColorBorderDefaultLight}, Dark={StaticResource ColorBorderDefault}}" />

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label
                                FontAttributes="Bold"
                                FontSize="15"
                                Text="Modo oscuro"
                                TextColor="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight},
                                                            Dark={StaticResource ColorTextPrimary}}" />
                            <Label
                                x:Name="LblModoDescripcion"
                                FontSize="12"
                                Text="Activo"
                                TextColor="{AppThemeBinding Light={StaticResource ColorTextSecondaryLight},
                                                            Dark={StaticResource ColorTextSecondary}}" />
                        </VerticalStackLayout>
                        <Switch
                            x:Name="SwitchDarkMode"
                            Grid.Column="1"
                            OnColor="{AppThemeBinding Light={StaticResource ColorPrimaryLight},
                                                      Dark={StaticResource ColorPrimary}}"
                            Toggled="OnDarkModeToggled" />
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!--  SERVIDOR  -->
            <Label
                FontAttributes="Bold"
                FontSize="13"
                IsVisible="False"
                Text="SERVIDOR ATU"
                TextColor="{AppThemeBinding Light={StaticResource ColorTextSecondaryLight},
                                            Dark={StaticResource ColorTextSecondary}}" />

            <Border
                Padding="18"
                BackgroundColor="{AppThemeBinding Light={StaticResource ColorSurfaceLight},
                                                  Dark={StaticResource ColorSurface}}"
                IsVisible="False"
                StrokeShape="RoundRectangle 18"
                StrokeThickness="0">

                <VerticalStackLayout Spacing="14">

                    <Label
                        FontAttributes="Bold"
                        FontSize="15"
                        Text="URL del servidor"
                        TextColor="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight},
                                                    Dark={StaticResource ColorTextPrimary}}" />

                    <Border
                        Padding="14"
                        BackgroundColor="{AppThemeBinding Light={StaticResource ColorSurfaceInputLight},
                                                          Dark={StaticResource ColorSurfaceInput}}"
                        Stroke="{AppThemeBinding Light={StaticResource ColorBorderInputLight},
                                                 Dark={StaticResource ColorBorderInput}}"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="1">

                        <Entry
                            x:Name="EntryUrl"
                            FontSize="16"
                            HeightRequest="44"
                            Keyboard="Url"
                            Placeholder="http://192.168.x.x:5002"
                            PlaceholderColor="{AppThemeBinding Light={StaticResource ColorPlaceholderLight},
                                                               Dark={StaticResource ColorPlaceholder}}"
                            TextColor="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight},
                                                        Dark={StaticResource ColorTextPrimary}}" />
                    </Border>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="14">

                        <Button
                            Grid.Column="0"
                            Padding="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource ColorPrimaryLight},
                                                              Dark={StaticResource ColorPrimary}}"
                            Clicked="OnGuardarUrl"
                            CornerRadius="14"
                            FontAttributes="Bold"
                            FontSize="16"
                            HeightRequest="52"
                            Text="Guardar"
                            TextColor="#FFFFFF">
                            <Button.Shadow>
                                <Shadow
                                    Brush="{AppThemeBinding Light={StaticResource ColorPrimaryLight},
                                                            Dark={StaticResource ColorPrimary}}"
                                    Opacity="0.30"
                                    Radius="8"
                                    Offset="0,3" />
                            </Button.Shadow>
                        </Button>

                        <Button
                            Grid.Column="1"
                            Padding="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource ColorBorderDefaultLight},
                                                              Dark={StaticResource ColorBorderDefault}}"
                            Clicked="OnProbarConexion"
                            CornerRadius="14"
                            FontSize="16"
                            HeightRequest="52"
                            Text="Probar"
                            TextColor="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight},
                                                        Dark={StaticResource ColorTextPrimary}}" />

                    </Grid>

                    <Label
                        x:Name="LblEstadoConexion"
                        FontAttributes="Bold"
                        FontSize="15"
                        HorizontalOptions="Center"
                        TextColor="{AppThemeBinding Light={StaticResource ColorTextSecondaryLight},
                                                    Dark={StaticResource ColorTextSecondary}}" />

                </VerticalStackLayout>
            </Border>

            <!--  DISPOSITIVO  -->
            <Label
                FontAttributes="Bold"
                FontSize="13"
                Text="DISPOSITIVO"
                TextColor="{AppThemeBinding Light={StaticResource ColorTextSecondaryLight},
                                            Dark={StaticResource ColorTextSecondary}}" />

            <Border
                Padding="18"
                BackgroundColor="{AppThemeBinding Light={StaticResource ColorSurfaceLight},
                                                  Dark={StaticResource ColorSurface}}"
                StrokeShape="RoundRectangle 18"
                StrokeThickness="0">

                <VerticalStackLayout Spacing="12">

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Label
                            Grid.Column="0"
                            FontAttributes="Bold"
                            FontSize="15"
                            Text="Modelo"
                            TextColor="{AppThemeBinding Light={StaticResource ColorTextSecondaryLight},
                                                        Dark={StaticResource ColorTextSecondary}}" />
                        <Label
                            x:Name="LblModelo"
                            Grid.Column="1"
                            FontAttributes="Bold"
                            FontSize="15"
                            TextColor="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight},
                                                        Dark={StaticResource ColorTextPrimary}}" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource ColorBorderDefaultLight}, Dark={StaticResource ColorBorderDefault}}" />

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Label
                            Grid.Column="0"
                            FontAttributes="Bold"
                            FontSize="15"
                            Text="Android"
                            TextColor="{AppThemeBinding Light={StaticResource ColorTextSecondaryLight},
                                                        Dark={StaticResource ColorTextSecondary}}" />
                        <Label
                            x:Name="LblAndroid"
                            Grid.Column="1"
                            FontAttributes="Bold"
                            FontSize="15"
                            TextColor="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight},
                                                        Dark={StaticResource ColorTextPrimary}}" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource ColorBorderDefaultLight}, Dark={StaticResource ColorBorderDefault}}" />

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Label
                            Grid.Column="0"
                            FontAttributes="Bold"
                            FontSize="15"
                            Text="Device ID"
                            TextColor="{AppThemeBinding Light={StaticResource ColorTextSecondaryLight},
                                                        Dark={StaticResource ColorTextSecondary}}" />
                        <Label
                            x:Name="LblDeviceId"
                            Grid.Column="1"
                            FontSize="13"
                            LineBreakMode="CharacterWrap"
                            TextColor="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight},
                                                        Dark={StaticResource ColorTextPrimary}}" />
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!--  LOGOUT  -->
            <Button
                Margin="0,12,0,0"
                Padding="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource ColorSurfaceDangerSoftLight},
                                                  Dark={StaticResource ColorSurfaceDangerSoft}}"
                Clicked="OnCerrarSesion"
                CornerRadius="16"
                FontAttributes="Bold"
                FontSize="17"
                HeightRequest="56"
                Text="Cerrar Sesión"
                TextColor="{AppThemeBinding Light={StaticResource ColorErrorLight},
                                            Dark={StaticResource ColorError}}" />

            <!--  VERSION  -->
            <Label
                Margin="0,12"
                FontSize="12"
                HorizontalOptions="Center"
                Text="ATU Cámara Fría v1.0 · mrlucky"
                TextColor="{AppThemeBinding Light={StaticResource ColorTextMutedLight},
                                            Dark={StaticResource ColorTextMuted}}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
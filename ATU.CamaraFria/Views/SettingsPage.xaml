<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ATU.CamaraFria.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    Title="Configuración"
    Padding="{OnPlatform iOS='0,48,0,0',
                         Default='0,12,0,12'}"
    ios:Page.UseSafeArea="True"
    BackgroundColor="#070B18">

    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="22">

            <!--  SESIÓN  -->
            <Label
                FontAttributes="Bold"
                FontSize="13"
                Text="SESIÓN ACTIVA"
                TextColor="#8CA0C0" />

            <Border
                Padding="18"
                BackgroundColor="#0F1724"
                StrokeShape="RoundRectangle 18"
                StrokeThickness="0">

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Label
                        FontSize="26"
                        Text="👤"
                        VerticalOptions="Center" />

                    <VerticalStackLayout Spacing="4">
                        <Label
                            x:Name="LblNombre"
                            FontAttributes="Bold"
                            FontSize="19"
                            TextColor="#FFFFFF" />
                        <Label
                            x:Name="LblEmpleado"
                            FontSize="15"
                            TextColor="#8CA0C0" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!--  SERVIDOR  -->
            <Label
                FontAttributes="Bold"
                FontSize="13"
                Text="SERVIDOR ATU"
                TextColor="#8CA0C0" />

            <Border
                Padding="18"
                BackgroundColor="#0F1724"
                StrokeShape="RoundRectangle 18"
                StrokeThickness="0">

                <VerticalStackLayout Spacing="14">

                    <Label
                        FontAttributes="Bold"
                        FontSize="15"
                        Text="URL del servidor"
                        TextColor="#FFFFFF" />

                    <!--  INPUT estilo iOS  -->
                    <Border
                        Padding="14"
                        BackgroundColor="#0A1120"
                        Stroke="#2A4A70"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="1">

                        <Entry
                            x:Name="EntryUrl"
                            FontSize="16"
                            HeightRequest="44"
                            Keyboard="Url"
                            Placeholder="http://192.168.x.x:5059"
                            PlaceholderColor="#4A6080"
                            TextColor="#FFFFFF" />
                    </Border>

                    <!--  BOTONES  -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">

                        <Button
                            Grid.Column="0"
                            Padding="0"
                            BackgroundColor="#0A84FF"
                            Clicked="OnGuardarUrl"
                            CornerRadius="14"
                            FontAttributes="Bold"
                            FontSize="16"
                            HeightRequest="52"
                            Text="Guardar"
                            TextColor="#FFFFFF">
                            <Button.Shadow>
                                <Shadow
                                    Brush="#0A84FF"
                                    Opacity="0.30"
                                    Radius="8"
                                    Offset="0,3" />
                            </Button.Shadow>
                        </Button>

                        <Button
                            Grid.Column="1"
                            Padding="0"
                            BackgroundColor="#1E3A5F"
                            Clicked="OnProbarConexion"
                            CornerRadius="14"
                            FontSize="16"
                            HeightRequest="52"
                            Text="Probar"
                            TextColor="#FFFFFF" />

                    </Grid>

                    <Label
                        x:Name="LblEstadoConexion"
                        FontAttributes="Bold"
                        FontSize="15"
                        HorizontalOptions="Center"
                        TextColor="#8CA0C0" />

                </VerticalStackLayout>
            </Border>

            <!--  DISPOSITIVO  -->
            <Label
                FontAttributes="Bold"
                FontSize="13"
                Text="DISPOSITIVO"
                TextColor="#8CA0C0" />

            <Border
                Padding="18"
                BackgroundColor="#0F1724"
                StrokeShape="RoundRectangle 18"
                StrokeThickness="0">

                <VerticalStackLayout Spacing="12">

                    <!--  FILAS tipo iOS  -->
                    <Grid ColumnDefinitions="Auto,*">
                        <Label
                            FontAttributes="Bold"
                            FontSize="15"
                            Text="Modelo"
                            TextColor="#8CA0C0" />
                        <Label
                            x:Name="LblModelo"
                            Grid.Column="1"
                            FontAttributes="Bold"
                            FontSize="15"
                            TextColor="#FFFFFF" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#1E3A5F" />

                    <Grid ColumnDefinitions="Auto,*">
                        <Label
                            FontAttributes="Bold"
                            FontSize="15"
                            Text="Android"
                            TextColor="#8CA0C0" />
                        <Label
                            x:Name="LblAndroid"
                            Grid.Column="1"
                            FontAttributes="Bold"
                            FontSize="15"
                            TextColor="#FFFFFF" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#1E3A5F" />

                    <Grid ColumnDefinitions="Auto,*">
                        <Label
                            FontAttributes="Bold"
                            FontSize="15"
                            Text="Device ID"
                            TextColor="#8CA0C0" />
                        <Label
                            x:Name="LblDeviceId"
                            Grid.Column="1"
                            FontSize="13"
                            LineBreakMode="CharacterWrap"
                            TextColor="#FFFFFF" />
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!--  LOGOUT  -->
            <Button
                Margin="0,12,0,0"
                Padding="0"
                BackgroundColor="#2A0A10"
                Clicked="OnCerrarSesion"
                CornerRadius="16"
                FontAttributes="Bold"
                FontSize="17"
                HeightRequest="56"
                Text="Cerrar Sesión"
                TextColor="#FF453A" />

            <!--  VERSION  -->
            <Label
                Margin="0,12"
                FontSize="12"
                HorizontalOptions="Center"
                Text="ATU Cámara Fría v1.0 · mrlucky"
                TextColor="#4A6080" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
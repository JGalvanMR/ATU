<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ATU.CamaraFria.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Configuración"
    Padding="{OnPlatform iOS='0,36,0,0',
                         Default='0'}"
    BackgroundColor="#070B18">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="18">

            <!--  SESIÓN  -->
            <Label
                FontSize="11"
                Text="SESIÓN ACTIVA"
                TextColor="#6A8FB0" />

            <Border
                Padding="16"
                BackgroundColor="#0D1525"
                StrokeShape="RoundRectangle 16"
                StrokeThickness="0">

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Label
                        FontSize="22"
                        Text="👤"
                        VerticalOptions="Center" />

                    <VerticalStackLayout Spacing="2">
                        <Label
                            x:Name="LblNombre"
                            FontAttributes="Bold"
                            FontSize="17"
                            TextColor="White" />
                        <Label
                            x:Name="LblEmpleado"
                            FontSize="13"
                            TextColor="#6A8FB0" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!--  SERVIDOR  -->
            <Label
                FontSize="11"
                Text="SERVIDOR ATU"
                TextColor="#6A8FB0" />

            <Border
                Padding="14"
                BackgroundColor="#0D1525"
                StrokeShape="RoundRectangle 16"
                StrokeThickness="0">

                <VerticalStackLayout Spacing="12">

                    <Label
                        FontSize="13"
                        Text="URL del servidor"
                        TextColor="#6A8FB0" />

                    <!--  INPUT estilo iOS  -->
                    <Border
                        Padding="12"
                        BackgroundColor="#13203A"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="0">

                        <Entry
                            x:Name="EntryUrl"
                            FontSize="14"
                            Keyboard="Url"
                            Placeholder="http://192.168.x.x:5059"
                            PlaceholderColor="#5A7FA8"
                            TextColor="White" />
                    </Border>

                    <!--  BOTONES  -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">

                        <Button
                            Grid.Column="0"
                            BackgroundColor="#00BFFF"
                            Clicked="OnGuardarUrl"
                            CornerRadius="14"
                            FontAttributes="Bold"
                            FontSize="15"
                            HeightRequest="48"
                            Text="Guardar"
                            TextColor="Black" />

                        <Button
                            Grid.Column="1"
                            BackgroundColor="#1E3050"
                            Clicked="OnProbarConexion"
                            CornerRadius="14"
                            FontSize="15"
                            HeightRequest="48"
                            Text="Probar"
                            TextColor="White" />

                    </Grid>

                    <Label
                        x:Name="LblEstadoConexion"
                        FontSize="13"
                        HorizontalOptions="Center"
                        TextColor="#6A8FB0" />

                </VerticalStackLayout>
            </Border>

            <!--  DISPOSITIVO  -->
            <Label
                FontSize="11"
                Text="DISPOSITIVO"
                TextColor="#6A8FB0" />

            <Border
                Padding="14"
                BackgroundColor="#0D1525"
                StrokeShape="RoundRectangle 16"
                StrokeThickness="0">

                <VerticalStackLayout Spacing="10">

                    <!--  FILAS tipo iOS  -->
                    <Grid ColumnDefinitions="Auto,*">
                        <Label
                            FontSize="13"
                            Text="Modelo"
                            TextColor="#6A8FB0" />
                        <Label
                            x:Name="LblModelo"
                            Grid.Column="1"
                            FontSize="13"
                            TextColor="White" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#1E3050" />

                    <Grid ColumnDefinitions="Auto,*">
                        <Label
                            FontSize="13"
                            Text="Android"
                            TextColor="#6A8FB0" />
                        <Label
                            x:Name="LblAndroid"
                            Grid.Column="1"
                            FontSize="13"
                            TextColor="White" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#1E3050" />

                    <Grid ColumnDefinitions="Auto,*">
                        <Label
                            FontSize="13"
                            Text="Device ID"
                            TextColor="#6A8FB0" />
                        <Label
                            x:Name="LblDeviceId"
                            Grid.Column="1"
                            FontSize="11"
                            LineBreakMode="CharacterWrap"
                            TextColor="White" />
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!--  LOGOUT  -->
            <Button
                Margin="0,10,0,0"
                BackgroundColor="#2A0A10"
                Clicked="OnCerrarSesion"
                CornerRadius="16"
                FontAttributes="Bold"
                FontSize="16"
                HeightRequest="52"
                Text="Cerrar Sesión"
                TextColor="#FF5E5E" />

            <!--  VERSION  -->
            <Label
                Margin="0,10"
                FontSize="10"
                HorizontalOptions="Center"
                Text="ATU Cámara Fría v1.0 · mrlucky"
                TextColor="#3A5070" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
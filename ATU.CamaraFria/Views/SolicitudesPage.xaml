<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ATU.CamaraFria.Views.SolicitudesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:ATU.CamaraFria.Models"
    Title="Solicitudes"
    Padding="{OnPlatform iOS='0,36,0,0',
                         Default='0'}"
    BackgroundColor="#070B18">

    <Grid RowDefinitions="Auto,*,Auto">

        <!--  HEADER (más limpio tipo iOS)  -->
        <Grid
            Grid.Row="0"
            Padding="16,12"
            ColumnDefinitions="*,Auto">

            <VerticalStackLayout Spacing="2">
                <Label
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="Solicitudes"
                    TextColor="White" />
                <Label
                    x:Name="LblUltimaActualizacion"
                    FontSize="11"
                    TextColor="#6A8FB0" />
            </VerticalStackLayout>

            <Button
                Grid.Column="1"
                BackgroundColor="#0D1525"
                Clicked="OnRefrescar"
                CornerRadius="22"
                FontSize="20"
                HeightRequest="44"
                Text="↻"
                TextColor="#00BFFF"
                WidthRequest="44" />
        </Grid>

        <!--  LISTA  -->
        <RefreshView
            x:Name="RefreshView"
            Grid.Row="1"
            RefreshColor="#00BFFF"
            Refreshing="OnRefrescar">

            <CollectionView x:Name="ListaSolicitudes" Margin="12,0">

                <!--  EMPTY  -->
                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        Margin="0,80,0,0"
                        HorizontalOptions="Center"
                        Spacing="10">

                        <Label FontSize="40" Text="📭" />
                        <Label
                            FontSize="15"
                            Text="Sin solicitudes"
                            TextColor="#6A8FB0" />
                        <Label
                            FontSize="12"
                            HorizontalTextAlignment="Center"
                            Text="Las solicitudes aparecerán automáticamente"
                            TextColor="#3A5070" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <!--  ITEM  -->
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:SolicitudVm">

                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems Mode="Execute">
                                    <SwipeItem
                                        BackgroundColor="#2A0A10"
                                        CommandParameter="{Binding .}"
                                        Invoked="OnIgnorarSolicitud"
                                        Text="Ignorar" />
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <!--  CARD MÁS LIGERA  -->
                            <Border
                                Margin="0,6"
                                Padding="14"
                                BackgroundColor="#0D1525"
                                StrokeShape="RoundRectangle 18"
                                StrokeThickness="0">

                                <VerticalStackLayout Spacing="8">

                                    <!--  FILA 1  -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="15"
                                            Text="{Binding TituloFolio}"
                                            TextColor="White" />
                                        <Label
                                            Grid.Column="1"
                                            FontSize="11"
                                            Text="{Binding TiempoTranscurrido}"
                                            TextColor="#6A8FB0" />
                                    </Grid>

                                    <!--  PRODUCTO  -->
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="14"
                                        LineBreakMode="TailTruncation"
                                        Text="{Binding InfoProducto}"
                                        TextColor="#00BFFF" />

                                    <!--  PALLET  -->
                                    <Label
                                        FontSize="12"
                                        Text="{Binding InfoPallet}"
                                        TextColor="#8AA0BC" />

                                    <!--  FOOTER  -->
                                    <Grid ColumnDefinitions="*,Auto">

                                        <Label
                                            FontSize="12"
                                            LineBreakMode="TailTruncation"
                                            Text="{Binding InfoSolicitante}"
                                            TextColor="#6A8FB0"
                                            VerticalOptions="Center" />

                                        <!--  BOTÓN iOS STYLE  -->
                                        <Button
                                            Grid.Column="1"
                                            Padding="18,0"
                                            BackgroundColor="#00BFFF"
                                            Clicked="OnAutorizarSolicitud"
                                            CommandParameter="{Binding .}"
                                            CornerRadius="18"
                                            FontAttributes="Bold"
                                            FontSize="13"
                                            HeightRequest="36"
                                            Text="Autorizar"
                                            TextColor="Black" />
                                    </Grid>

                                </VerticalStackLayout>
                            </Border>
                        </SwipeView>

                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!--  FOOTER  -->
        <Label
            Grid.Row="2"
            Margin="0,6"
            FontSize="10"
            HorizontalOptions="Center"
            Text="Desliza para ignorar · Autoriza para generar OTP"
            TextColor="#3A5070" />

    </Grid>
</ContentPage>
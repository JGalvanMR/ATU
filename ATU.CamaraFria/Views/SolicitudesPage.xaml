<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ATU.CamaraFria.Views.SolicitudesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:models="clr-namespace:ATU.CamaraFria.Models"
    Title="Solicitudes"
    Padding="{OnPlatform iOS='0,48,0,0',
                         Default='0,12,0,12'}"
    ios:Page.UseSafeArea="True"
    BackgroundColor="#070B18">

    <Grid RowDefinitions="Auto,*,Auto">

        <!--  HEADER (más limpio tipo iOS)  -->
        <Grid
            Grid.Row="0"
            Padding="18,14"
            ColumnDefinitions="*,Auto">

            <VerticalStackLayout Spacing="4">
                <Label
                    FontAttributes="Bold"
                    FontSize="22"
                    Text="Solicitudes"
                    TextColor="#FFFFFF" />
                <Label
                    x:Name="LblUltimaActualizacion"
                    FontSize="13"
                    TextColor="#8CA0C0" />
            </VerticalStackLayout>

            <Button
                Grid.Column="1"
                Padding="0"
                BackgroundColor="#0F1724"
                Clicked="OnRefrescar"
                CornerRadius="24"
                FontSize="22"
                HeightRequest="48"
                Text="↻"
                TextColor="#0A84FF"
                WidthRequest="48" />
        </Grid>

        <!--  LISTA  -->
        <RefreshView
            x:Name="RefreshView"
            Grid.Row="1"
            RefreshColor="#0A84FF"
            Refreshing="OnRefrescar">

            <CollectionView x:Name="ListaSolicitudes" Margin="14,0">

                <!--  EMPTY  -->
                <CollectionView.EmptyView>
                    <VerticalStackLayout
                        Margin="0,80,0,0"
                        HorizontalOptions="Center"
                        Spacing="12">

                        <Label FontSize="52" Text="📭" />
                        <Label
                            FontAttributes="Bold"
                            FontSize="18"
                            Text="Sin solicitudes"
                            TextColor="#8CA0C0" />
                        <Label
                            FontSize="14"
                            HorizontalTextAlignment="Center"
                            Text="Las solicitudes aparecerán automáticamente"
                            TextColor="#4A6080" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <!--  ITEM  -->
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:SolicitudVm">

                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems Mode="Execute">
                                    <SwipeItem
                                        BackgroundColor="#2A0A10"
                                        CommandParameter="{Binding .}"
                                        Invoked="OnIgnorarSolicitud"
                                        Text="Ignorar" />
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <!--  CARD MÁS LIGERA  -->
                            <Border
                                Margin="0,8"
                                Padding="16"
                                BackgroundColor="#0F1724"
                                StrokeShape="RoundRectangle 20"
                                StrokeThickness="0">

                                <VerticalStackLayout Spacing="10">

                                    <!--  FILA 1  -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="17"
                                            Text="{Binding TituloFolio}"
                                            TextColor="#FFFFFF" />
                                        <Label
                                            Grid.Column="1"
                                            FontAttributes="Bold"
                                            FontSize="13"
                                            Text="{Binding TiempoTranscurrido}"
                                            TextColor="#8CA0C0" />
                                    </Grid>

                                    <!--  PRODUCTO  -->
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="16"
                                        LineBreakMode="TailTruncation"
                                        Text="{Binding InfoProducto}"
                                        TextColor="#0A84FF" />

                                    <!--  PALLET  -->
                                    <Label
                                        FontSize="14"
                                        Text="{Binding InfoPallet}"
                                        TextColor="#8CA0C0" />

                                    <!--  FOOTER  -->
                                    <Grid ColumnDefinitions="*,Auto">

                                        <Label
                                            FontSize="14"
                                            LineBreakMode="TailTruncation"
                                            Text="{Binding InfoSolicitante}"
                                            TextColor="#8CA0C0"
                                            VerticalOptions="Center" />

                                        <!--  BOTÓN iOS STYLE - Mínimo 44pt táctil  -->
                                        <Button
                                            Grid.Column="1"
                                            Padding="20,0"
                                            BackgroundColor="#0A84FF"
                                            Clicked="OnAutorizarSolicitud"
                                            CommandParameter="{Binding .}"
                                            CornerRadius="20"
                                            FontAttributes="Bold"
                                            FontSize="15"
                                            HeightRequest="44"
                                            Text="Autorizar"
                                            TextColor="#FFFFFF"
                                            VerticalOptions="Center">
                                            <Button.Shadow>
                                                <Shadow
                                                    Brush="#0A84FF"
                                                    Opacity="0.25"
                                                    Radius="6"
                                                    Offset="0,2" />
                                            </Button.Shadow>
                                        </Button>
                                    </Grid>

                                </VerticalStackLayout>
                            </Border>
                        </SwipeView>

                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <!--  FOOTER  -->
        <Label
            Grid.Row="2"
            Margin="0,8"
            FontSize="12"
            HorizontalOptions="Center"
            Text="Desliza para ignorar · Autoriza para generar OTP"
            TextColor="#4A6080" />

    </Grid>
</ContentPage>
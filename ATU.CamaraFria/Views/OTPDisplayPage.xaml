<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ATU.CamaraFria.Views.OTPDisplayPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:viewmodel="clr-namespace:ATU.CamaraFria.ViewModels"
    ios:Page.UseSafeArea="True"
    x:DataType="viewmodel:OTPViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource ColorBackgroundLight},
                                      Dark={StaticResource ColorBackground}}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!--  Header  -->
        <Grid
            Grid.Row="0"
            Padding="18,16"
            ColumnDefinitions="*,Auto,Auto">
            <Label
                Grid.Column="0"
                FontAttributes="Bold"
                FontSize="18"
                Text="ATU · Cámara Fría"
                TextColor="{AppThemeBinding Light={StaticResource ColorPrimaryLight},
                                            Dark={StaticResource ColorPrimary}}"
                VerticalOptions="Center" />
            <Border
                x:Name="ConnectionIndicator"
                Grid.Column="1"
                Margin="0,0,12,0"
                BackgroundColor="{AppThemeBinding Light={StaticResource ColorSuccessLight},
                                                  Dark={StaticResource ColorSuccess}}"
                HeightRequest="12"
                StrokeShape="RoundRectangle 6"
                VerticalOptions="Center"
                WidthRequest="12" />
            <Label
                Grid.Column="2"
                FontAttributes="Bold"
                FontSize="14"
                IsVisible="{Binding EsFolioAdelantado}"
                Text="{Binding EmbFolio, StringFormat='Folio: {0}'}"
                TextColor="{AppThemeBinding Light={StaticResource ColorPrimaryLight},
                                            Dark={StaticResource ColorPrimary}}"
                VerticalOptions="Center" />
        </Grid>

        <!--
            ══════════════════════════════════════════════════════
            PANEL 1 — Escaneo libre de etiqueta verde
            ══════════════════════════════════════════════════════
        -->
        <ScrollView Grid.Row="1" IsVisible="{Binding ShowScanNormal}">
            <VerticalStackLayout
                Padding="10"
                Spacing="24"
                VerticalOptions="Center">

                <VerticalStackLayout HorizontalOptions="Center" Spacing="10">
                    <Label
                        FontSize="44"
                        HorizontalOptions="Center"
                        Text="📷" />
                    <Label
                        FontAttributes="Bold"
                        FontSize="20"
                        HorizontalOptions="Center"
                        Text="Listo para escanear"
                        TextColor="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight},
                                                    Dark={StaticResource ColorTextPrimary}}" />
                    <Label
                        FontSize="15"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        Text="Apunta el scanner a la etiqueta verde del pallet"
                        TextColor="{AppThemeBinding Light={StaticResource ColorTextSecondaryLight},
                                                    Dark={StaticResource ColorTextSecondary}}" />
                </VerticalStackLayout>

                <Border
                    Padding="0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource ColorSurfaceInputLight},
                                                      Dark={StaticResource ColorSurfaceInput}}"
                    Stroke="{AppThemeBinding Light={StaticResource ColorPrimaryLight},
                                             Dark={StaticResource ColorPrimary}}"
                    StrokeShape="RoundRectangle 14"
                    StrokeThickness="2.5">
                    <Entry
                        x:Name="EntryEscaneo"
                        Margin="14,16"
                        ClearButtonVisibility="WhileEditing"
                        FontAttributes="Bold"
                        FontSize="18"
                        HeightRequest="48"
                        Placeholder="Scanner listo — o escribe el código"
                        PlaceholderColor="{AppThemeBinding Light={StaticResource ColorPlaceholderLight},
                                                           Dark={StaticResource ColorPlaceholder}}"
                        ReturnCommand="{Binding ProcesarCodigoEscaneadoCommand}"
                        ReturnType="Go"
                        Text="{Binding CodigoEscaneado}"
                        TextColor="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight},
                                                    Dark={StaticResource ColorTextPrimary}}" />
                </Border>

                <Border
                    Padding="16"
                    BackgroundColor="{AppThemeBinding Light={StaticResource ColorSurfaceInputLight},
                                                      Dark={StaticResource ColorSurfaceInput}}"
                    IsVisible="{Binding IsProcessing, Converter={StaticResource InverseBoolConverter}}"
                    Stroke="{AppThemeBinding Light={StaticResource ColorBorderDefaultLight},
                                             Dark={StaticResource ColorBorderDefault}}"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="1.5">
                    <Label
                        FontAttributes="Bold"
                        FontSize="16"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        Text="{Binding StatusMessage}"
                        TextColor="{Binding StatusColor}" />
                </Border>

                <ActivityIndicator
                    HorizontalOptions="Center"
                    IsRunning="{Binding IsProcessing}"
                    IsVisible="{Binding IsProcessing}"
                    Color="{AppThemeBinding Light={StaticResource ColorPrimaryLight},
                                            Dark={StaticResource ColorPrimary}}" />

                <Button
                    Padding="0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource ColorPrimaryLight},
                                                      Dark={StaticResource ColorPrimary}}"
                    Command="{Binding ProcesarCodigoEscaneadoCommand}"
                    CornerRadius="14"
                    FontAttributes="Bold"
                    FontSize="18"
                    HeightRequest="56"
                    Text="⚡  Generar OTP"
                    TextColor="#FFFFFF">
                    <Button.Shadow>
                        <Shadow
                            Brush="{AppThemeBinding Light={StaticResource ColorPrimaryLight},
                                                    Dark={StaticResource ColorPrimary}}"
                            Opacity="0.30"
                            Radius="8"
                            Offset="0,4" />
                    </Button.Shadow>
                </Button>
            </VerticalStackLayout>
        </ScrollView>

        <!--
            ══════════════════════════════════════════════════════
            PANEL 2 — Confirmar pallet físico (folio adelantado)
            ══════════════════════════════════════════════════════
        -->
        <ScrollView Grid.Row="1" IsVisible="{Binding ShowConfirmarFolio}">
            <VerticalStackLayout Padding="20" Spacing="20">

                <Border
                    Padding="9"
                    BackgroundColor="{AppThemeBinding Light={StaticResource ColorSurfaceWarningSoftLight},
                                                      Dark={StaticResource ColorSurfaceWarningSoft}}"
                    Stroke="{AppThemeBinding Light={StaticResource ColorWarningLight},
                                             Dark={StaticResource ColorWarning}}"
                    StrokeShape="RoundRectangle 14"
                    StrokeThickness="2">
                    <VerticalStackLayout Spacing="5">
                        <Label
                            CharacterSpacing="1"
                            FontAttributes="Bold"
                            FontSize="13"
                            Text="Solicitud de folio adelantado"
                            TextColor="{AppThemeBinding Light={StaticResource ColorWarningLight},
                                                        Dark={StaticResource ColorWarning}}"
                            TextTransform="Uppercase" />
                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            Text="{Binding InfoProducto}"
                            TextColor="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight},
                                                        Dark={StaticResource ColorTextPrimary}}" />
                        <Label
                            FontAttributes="Bold"
                            FontSize="14"
                            Text="{Binding BatchId}"
                            TextColor="{AppThemeBinding Light={StaticResource ColorPrimaryLight},
                                                        Dark={StaticResource ColorPrimary}}" />
                        <BoxView
                            Margin="0,4"
                            HeightRequest="1"
                            Color="{AppThemeBinding Light={StaticResource ColorBorderDefaultLight},
                                                    Dark={StaticResource ColorBorderDefault}}" />
                        <Grid ColumnDefinitions="Auto,*">
                            <Label
                                Grid.Column="0"
                                FontAttributes="Bold"
                                FontSize="14"
                                Text="Solicitó:"
                                TextColor="{AppThemeBinding Light={StaticResource ColorTextSecondaryLight},
                                                            Dark={StaticResource ColorTextSecondary}}"
                                WidthRequest="75" />
                            <Label
                                Grid.Column="1"
                                FontSize="14"
                                Text="{Binding InfoSolicitante}"
                                TextColor="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight},
                                                            Dark={StaticResource ColorTextPrimary}}" />
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*">
                            <Label
                                Grid.Column="0"
                                FontAttributes="Bold"
                                FontSize="14"
                                Text="Motivo:"
                                TextColor="{AppThemeBinding Light={StaticResource ColorTextSecondaryLight},
                                                            Dark={StaticResource ColorTextSecondary}}"
                                WidthRequest="75" />
                            <Label
                                Grid.Column="1"
                                FontSize="14"
                                Text="{Binding MotivoSolicitud}"
                                TextColor="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight},
                                                            Dark={StaticResource ColorTextPrimary}}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Label
                    FontAttributes="Bold"
                    FontSize="16"
                    HorizontalOptions="Center"
                    Text="Paso 1: Confirma el pallet físico"
                    TextColor="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight},
                                                Dark={StaticResource ColorTextPrimary}}" />
                <Label
                    FontSize="14"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    LineBreakMode="WordWrap"
                    Text="{Binding InstruccionConfirmar}"
                    TextColor="{AppThemeBinding Light={StaticResource ColorTextSecondaryLight},
                                                Dark={StaticResource ColorTextSecondary}}" />

                <Border
                    Padding="0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource ColorSurfaceInputLight},
                                                      Dark={StaticResource ColorSurfaceInput}}"
                    Stroke="{AppThemeBinding Light={StaticResource ColorWarningLight},
                                             Dark={StaticResource ColorWarning}}"
                    StrokeShape="RoundRectangle 14"
                    StrokeThickness="2.5">
                    <Entry
                        x:Name="EntryConfirmar"
                        Margin="7,8"
                        ClearButtonVisibility="WhileEditing"
                        FontAttributes="Bold"
                        FontSize="16"
                        Placeholder="Escanea el código del pallet a autorizar"
                        PlaceholderColor="{AppThemeBinding Light={StaticResource ColorPlaceholderLight},
                                                           Dark={StaticResource ColorPlaceholder}}"
                        ReturnCommand="{Binding ConfirmarPalletCommand}"
                        ReturnType="Go"
                        Text="{Binding CodigoPalletConfirmar}"
                        TextColor="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight},
                                                    Dark={StaticResource ColorTextPrimary}}" />
                </Border>

                <Border
                    Padding="16"
                    BackgroundColor="{AppThemeBinding Light={StaticResource ColorSurfaceSuccessLight},
                                                      Dark={StaticResource ColorSurfaceSuccess}}"
                    IsVisible="{Binding PalletConfirmado}"
                    Stroke="{AppThemeBinding Light={StaticResource ColorSuccessLight},
                                             Dark={StaticResource ColorSuccess}}"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="2">
                    <Label
                        FontAttributes="Bold"
                        FontSize="17"
                        HorizontalOptions="Center"
                        Text="{Binding PalletConfirmadoTexto}"
                        TextColor="{AppThemeBinding Light={StaticResource ColorSuccessLight},
                                                    Dark={StaticResource ColorSuccess}}" />
                </Border>

                <ActivityIndicator
                    HorizontalOptions="Center"
                    IsRunning="{Binding IsProcessing}"
                    IsVisible="{Binding IsProcessing}"
                    Color="{AppThemeBinding Light={StaticResource ColorWarningLight},
                                            Dark={StaticResource ColorWarning}}" />

                <Button
                    Padding="0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource ColorWarningLight},
                                                      Dark={StaticResource ColorWarning}}"
                    Command="{Binding ConfirmarPalletCommand}"
                    CornerRadius="14"
                    FontAttributes="Bold"
                    FontSize="14"
                    HeightRequest="54"
                    Text="Confirmar"
                    TextColor="{AppThemeBinding Light={StaticResource ColorTextOnWarningLight},
                                                Dark={StaticResource ColorTextOnWarning}}">
                    <Button.Shadow>
                        <Shadow
                            Brush="{AppThemeBinding Light={StaticResource ColorWarningLight},
                                                    Dark={StaticResource ColorWarning}}"
                            Opacity="0.30"
                            Radius="8"
                            Offset="0,4" />
                    </Button.Shadow>
                </Button>

                <!--  Botón de autorización rápida (sin escaneo)  -->
                <Button
                    Padding="0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource ColorSuccessLight},
                                                      Dark={StaticResource ColorSuccess}}"
                    Command="{Binding AutorizarRapidoCommand}"
                    CornerRadius="14"
                    FontAttributes="Bold"
                    FontSize="14"
                    HeightRequest="54"
                    IsEnabled="{Binding !IsProcessing}"
                    Text="✅ Autorizar sin escanear"
                    TextColor="{AppThemeBinding Light={StaticResource ColorTextOnSuccessLight},
                                                Dark={StaticResource ColorTextOnSuccess}}">
                    <Button.Shadow>
                        <Shadow
                            Brush="{AppThemeBinding Light={StaticResource ColorSuccessLight},
                                                    Dark={StaticResource ColorSuccess}}"
                            Opacity="0.30"
                            Radius="8"
                            Offset="0,4" />
                    </Button.Shadow>
                </Button>

                <Button
                    Padding="0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource ColorBorderDefaultLight},
                                                      Dark={StaticResource ColorBorderDefault}}"
                    Command="{Binding ResetScanCommand}"
                    CornerRadius="14"
                    FontSize="14"
                    HeightRequest="48"
                    Text="Cancelar"
                    TextColor="{AppThemeBinding Light={StaticResource ColorTextSecondaryLight},
                                                Dark={StaticResource ColorTextSecondary}}" />
            </VerticalStackLayout>
        </ScrollView>

        <!--
            ══════════════════════════════════════════════════════
            PANEL 3 — OTP generado
            ══════════════════════════════════════════════════════
        -->
        <ScrollView Grid.Row="1" IsVisible="{Binding ShowOTP}">
            <VerticalStackLayout
                Padding="20"
                Spacing="20"
                VerticalOptions="Center">

                <Border
                    Padding="18"
                    BackgroundColor="{AppThemeBinding Light={StaticResource ColorSurfaceLight},
                                                      Dark={StaticResource ColorSurface}}"
                    Stroke="{AppThemeBinding Light={StaticResource ColorBorderDefaultLight},
                                             Dark={StaticResource ColorBorderDefault}}"
                    StrokeShape="RoundRectangle 14"
                    StrokeThickness="1.5">
                    <Grid
                        ColumnDefinitions="80,*"
                        RowDefinitions="Auto,Auto,Auto"
                        RowSpacing="10">
                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            FontAttributes="Bold"
                            FontSize="15"
                            Text="Lote:"
                            TextColor="{AppThemeBinding Light={StaticResource ColorTextSecondaryLight},
                                                        Dark={StaticResource ColorTextSecondary}}" />
                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            FontAttributes="Bold"
                            FontSize="16"
                            LineBreakMode="TailTruncation"
                            Text="{Binding BatchId}"
                            TextColor="{AppThemeBinding Light={StaticResource ColorPrimaryLight},
                                                        Dark={StaticResource ColorPrimary}}" />
                        <Label
                            Grid.Row="1"
                            Grid.Column="0"
                            FontAttributes="Bold"
                            FontSize="15"
                            IsVisible="{Binding EsFolioAdelantado}"
                            Text="Folio:"
                            TextColor="{AppThemeBinding Light={StaticResource ColorTextSecondaryLight},
                                                        Dark={StaticResource ColorTextSecondary}}" />
                        <Label
                            Grid.Row="1"
                            Grid.Column="1"
                            FontAttributes="Bold"
                            FontSize="15"
                            IsVisible="{Binding EsFolioAdelantado}"
                            Text="{Binding EmbFolio}"
                            TextColor="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight},
                                                        Dark={StaticResource ColorTextPrimary}}" />
                        <Label
                            Grid.Row="2"
                            Grid.Column="0"
                            FontAttributes="Bold"
                            FontSize="15"
                            IsVisible="{Binding EsFolioAdelantado}"
                            Text="Para:"
                            TextColor="{AppThemeBinding Light={StaticResource ColorTextSecondaryLight},
                                                        Dark={StaticResource ColorTextSecondary}}" />
                        <Label
                            Grid.Row="2"
                            Grid.Column="1"
                            FontSize="14"
                            IsVisible="{Binding EsFolioAdelantado}"
                            LineBreakMode="TailTruncation"
                            Text="{Binding InfoSolicitante}"
                            TextColor="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight},
                                                        Dark={StaticResource ColorTextPrimary}}" />
                    </Grid>
                </Border>

                <!--  OTP grande  -->
                <Border
                    Padding="14,12"
                    BackgroundColor="{AppThemeBinding Light={StaticResource ColorSurfaceInputLight},
                                                      Dark={StaticResource ColorSurfaceInput}}"
                    Stroke="{AppThemeBinding Light={StaticResource ColorPrimaryLight},
                                             Dark={StaticResource ColorPrimary}}"
                    StrokeShape="RoundRectangle 24"
                    StrokeThickness="3">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="12">
                        <Label
                            CharacterSpacing="4"
                            FontAttributes="Bold"
                            FontSize="13"
                            HorizontalOptions="Center"
                            Text="CÓDIGO OTP"
                            TextColor="{AppThemeBinding Light={StaticResource ColorTextSecondaryLight},
                                                        Dark={StaticResource ColorTextSecondary}}" />
                        <Label
                            CharacterSpacing="9"
                            FontAttributes="Bold"
                            FontSize="72"
                            HorizontalOptions="Center"
                            Text="{Binding OtpCode}"
                            TextColor="{AppThemeBinding Light={StaticResource ColorSuccessLight},
                                                        Dark={StaticResource ColorSuccess}}" />
                        <Label
                            FontSize="15"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            Text="Díctalo en voz alta al operador de embarques"
                            TextColor="{AppThemeBinding Light={StaticResource ColorTextSecondaryLight},
                                                        Dark={StaticResource ColorTextSecondary}}" />
                    </VerticalStackLayout>
                </Border>

                <!--  Countdown  -->
                <Border
                    Padding="20,16"
                    BackgroundColor="{AppThemeBinding Light={StaticResource ColorSurfaceLight},
                                                      Dark={StaticResource ColorSurface}}"
                    Stroke="{AppThemeBinding Light={StaticResource ColorErrorLight},
                                             Dark={StaticResource ColorError}}"
                    StrokeShape="RoundRectangle 14"
                    StrokeThickness="2">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Grid.Column="0"
                            FontAttributes="Bold"
                            FontSize="18"
                            Text="Expira en:"
                            TextColor="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight},
                                                        Dark={StaticResource ColorTextPrimary}}"
                            VerticalOptions="Center" />
                        <Label
                            Grid.Column="1"
                            FontAttributes="Bold"
                            FontSize="52"
                            Text="{Binding CountdownText}"
                            TextColor="{AppThemeBinding Light={StaticResource ColorErrorLight},
                                                        Dark={StaticResource ColorError}}"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Button
                    Padding="0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource ColorBorderDefaultLight},
                                                      Dark={StaticResource ColorBorderDefault}}"
                    Command="{Binding ResetScanCommand}"
                    CornerRadius="14"
                    FontSize="16"
                    HeightRequest="54"
                    Text="🔄  Escanear Nuevo Lote"
                    TextColor="{AppThemeBinding Light={StaticResource ColorTextPrimaryLight},
                                                Dark={StaticResource ColorTextPrimary}}" />
            </VerticalStackLayout>
        </ScrollView>

        <!--  Bottom bar  -->
        <Border
            Grid.Row="2"
            Padding="16,10"
            BackgroundColor="{AppThemeBinding Light={StaticResource ColorBottomBarLight},
                                              Dark={StaticResource ColorBottomBar}}">
            <Label
                FontSize="12"
                HorizontalOptions="Center"
                Text="Código único · Expira en 30 s · Vinculado al lote"
                TextColor="{AppThemeBinding Light={StaticResource ColorTextMutedLight},
                                            Dark={StaticResource ColorTextMuted}}" />
        </Border>
    </Grid>
</ContentPage>
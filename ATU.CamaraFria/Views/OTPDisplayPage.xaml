<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ATU.CamaraFria.Views.OTPDisplayPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodel="clr-namespace:ATU.CamaraFria.ViewModels"
    x:DataType="viewmodel:OTPViewModel"
    BackgroundColor="#070B18">

    <Grid RowDefinitions="Auto,*,Auto">

        <!--  Header  -->
        <Grid
            Grid.Row="0"
            Padding="15"
            ColumnDefinitions="*,Auto">
            <Label
                Grid.Column="0"
                FontAttributes="Bold"
                FontSize="18"
                Text="ATU Cámara Fría"
                TextColor="#00BFFF"
                VerticalOptions="Center" />
            <Border
                x:Name="ConnectionIndicator"
                Grid.Column="1"
                BackgroundColor="#44FF44"
                HeightRequest="12"
                StrokeShape="Circle"
                WidthRequest="12" />
        </Grid>

        <!--  ZONA ESCANEO / INGRESO MANUAL  -->
        <VerticalStackLayout
            Grid.Row="1"
            Padding="30"
            HorizontalOptions="Center"
            IsVisible="{Binding ShowScan}"
            Spacing="20"
            VerticalOptions="Center">

            <!--  Área visual de escaneo  -->
            <Border
                BackgroundColor="Transparent"
                HeightRequest="250"
                Stroke="#00BFFF"
                StrokeDashArray="5,5"
                StrokeShape="RoundRectangle 20"
                StrokeThickness="3"
                WidthRequest="250">
                <Label
                    FontSize="18"
                    HorizontalOptions="Center"
                    Text="📷\nEscanea aquí"
                    TextColor="#444"
                    VerticalOptions="Center" />
            </Border>

            <Label
                FontSize="16"
                HorizontalOptions="Center"
                LineBreakMode="WordWrap"
                Text="{Binding StatusMessage}"
                TextColor="{Binding StatusColor}" />

            <Label
                FontSize="12"
                HorizontalOptions="Center"
                Text="───────── O ingresa manualmente ─────────"
                TextColor="#444" />

            <Border
                BackgroundColor="#1a1f35"
                Stroke="#333"
                StrokeShape="RoundRectangle 10">
                <Entry
                    Margin="10,12"
                    FontSize="16"
                    HorizontalTextAlignment="Center"
                    Placeholder="Código de lote (ej: L-20240115-001)"
                    PlaceholderColor="#555"
                    ReturnCommand="{Binding ProcessScannedCodeCommand}"
                    Text="{Binding ScannedCode}"
                    TextColor="White" />
            </Border>

            <Button
                BackgroundColor="#00BFFF"
                Command="{Binding ProcessScannedCodeCommand}"
                CornerRadius="10"
                FontAttributes="Bold"
                FontSize="16"
                HeightRequest="50"
                IsEnabled="{Binding IsNotBusy}"
                Text=" Generar OTP"
                TextColor="Black" />
        </VerticalStackLayout>

        <!--  ZONA OTP CON COUNTDOWN  -->
        <Grid
            Grid.Row="1"
            IsVisible="{Binding ShowOTP}"
            RowDefinitions="Auto,Auto,Auto,Auto"
            VerticalOptions="Center">

            <!--  Info del lote  -->
            <Border
                Grid.Row="0"
                Margin="20,0"
                Padding="15"
                BackgroundColor="#1a1f35"
                Stroke="#333"
                StrokeShape="RoundRectangle 10">
                <Grid ColumnDefinitions="Auto,*">
                    <Label
                        Grid.Column="0"
                        FontSize="14"
                        Text="📦 Lote:"
                        TextColor="#AAA"
                        VerticalOptions="Center" />
                    <Label
                        Grid.Column="1"
                        FontAttributes="Bold"
                        FontSize="18"
                        HorizontalOptions="End"
                        Text="{Binding BatchId}"
                        TextColor="White"
                        VerticalOptions="Center" />
                </Grid>
            </Border>

            <!--  CÓDIGO OTP GRANDE  -->
            <Border
                Grid.Row="1"
                Margin="20"
                Padding="20"
                BackgroundColor="#0f1428"
                Stroke="#00BFFF"
                StrokeShape="RoundRectangle 25"
                StrokeThickness="3">
                <VerticalStackLayout
                    HorizontalOptions="Center"
                    Spacing="10"
                    VerticalOptions="Center">
                    <Label
                        CharacterSpacing="5"
                        FontSize="14"
                        HorizontalOptions="Center"
                        Text="CÓDIGO OTP"
                        TextColor="#666" />
                    <!--  Código completo en una sola línea para evitar errores de indexación XAML  -->
                    <Label
                        FontAttributes="Bold"
                        FontSize="64"
                        HorizontalOptions="Center"
                        Text="{Binding OtpCode}"
                        TextColor="#00FF00"
                        VerticalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!--  COUNTDOWN TIMER  -->
            <Border
                Grid.Row="2"
                Margin="40,10"
                Padding="15"
                BackgroundColor="#0f1428"
                Stroke="#FF4444"
                StrokeShape="RoundRectangle 15"
                StrokeThickness="2">
                <Grid ColumnDefinitions="*,Auto">
                    <Label
                        Grid.Column="0"
                        FontSize="16"
                        HorizontalOptions="End"
                        Text="⏱️ Expira en:"
                        TextColor="#AAA"
                        VerticalOptions="Center" />
                    <Label
                        Grid.Column="1"
                        Margin="15,0"
                        FontAttributes="Bold"
                        FontSize="36"
                        HorizontalOptions="Center"
                        Text="{Binding CountdownText}"
                        TextColor="#FF4444"
                        VerticalOptions="Center" />
                </Grid>
            </Border>

            <!--  Status y Botón resetear  -->
            <VerticalStackLayout
                Grid.Row="3"
                Margin="20,10"
                Spacing="15">
                <Label
                    FontSize="16"
                    HorizontalOptions="Center"
                    Text="{Binding StatusMessage}"
                    TextColor="{Binding StatusColor}" />
                <Button
                    BackgroundColor="#333"
                    Command="{Binding ResetScanCommand}"
                    CornerRadius="10"
                    FontSize="16"
                    HeightRequest="50"
                    Text="🔄 Escanear Nuevo Lote"
                    TextColor="White" />
            </VerticalStackLayout>
        </Grid>

        <!--  Bottom Bar  -->
        <Border
            Grid.Row="2"
            Padding="15,10"
            BackgroundColor="#0a0e1a">
            <Label
                FontSize="11"
                HorizontalOptions="Center"
                Text="🔒 Cada código es único y está vinculado al lote | v1.0"
                TextColor="#444"
                VerticalOptions="Center" />
        </Border>
    </Grid>
</ContentPage>
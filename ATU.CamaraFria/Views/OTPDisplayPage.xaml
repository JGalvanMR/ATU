<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ATU.CamaraFria.Views.OTPDisplayPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodel="clr-namespace:ATU.CamaraFria.ViewModels"
    xmlns:zxing="clr-namespace:ZXing.Net.Maui.Controls;assembly=ZXing.Net.MAUI.Controls"
    x:DataType="viewmodel:OTPViewModel"
    BackgroundColor="#070B18">

    <Grid RowDefinitions="Auto,*,Auto">

        <!--  Header  -->
        <Grid
            Grid.Row="0"
            Padding="16,12"
            ColumnDefinitions="*,Auto">
            <Label
                Grid.Column="0"
                FontAttributes="Bold"
                FontSize="17"
                Text="ATU · Cámara Fría"
                TextColor="#00BFFF"
                VerticalOptions="Center" />
            <Border
                x:Name="ConnectionIndicator"
                Grid.Column="1"
                BackgroundColor="#44FF44"
                HeightRequest="10"
                StrokeShape="RoundRectangle 5"
                VerticalOptions="Center"
                WidthRequest="10" />
        </Grid>

        <!--  ══ PANEL 1: Escaneo libre de etiqueta verde ══  -->
        <Grid Grid.Row="1" IsVisible="{Binding ShowScanNormal}">

            <zxing:CameraBarcodeReaderView
                x:Name="CameraScanner"
                BarcodesDetected="OnBarcodesDetected"
                HorizontalOptions="Fill"
                IsDetecting="True"
                VerticalOptions="Fill" />

            <Grid>
                <!--  Marco de escaneo  -->
                <Border
                    BackgroundColor="Transparent"
                    HeightRequest="240"
                    HorizontalOptions="Center"
                    Stroke="#00BFFF"
                    StrokeDashArray="10,5"
                    StrokeShape="RoundRectangle 16"
                    StrokeThickness="2"
                    VerticalOptions="Center"
                    WidthRequest="240" />

                <Label
                    Margin="0,-160,0,0"
                    FontSize="14"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Text="Apunta al código de la etiqueta verde del pallet"
                    TextColor="White"
                    VerticalOptions="Center" />

                <!--  Panel inferior  -->
                <VerticalStackLayout
                    Padding="20,0,20,24"
                    Spacing="8"
                    VerticalOptions="End">
                    <Label
                        FontSize="13"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        Text="{Binding StatusMessage}"
                        TextColor="{Binding StatusColor}" />
                    <Border
                        BackgroundColor="#CC070B18"
                        Stroke="#1E3050"
                        StrokeShape="RoundRectangle 10">
                        <Entry
                            Margin="10,10"
                            FontSize="14"
                            Placeholder="O ingresa el código manualmente"
                            PlaceholderColor="#3A5070"
                            ReturnCommand="{Binding ProcessScannedCodeCommand}"
                            Text="{Binding ScannedCode}"
                            TextColor="White" />
                    </Border>
                    <Button
                        BackgroundColor="#00BFFF"
                        Command="{Binding ProcessScannedCodeCommand}"
                        CornerRadius="10"
                        FontAttributes="Bold"
                        FontSize="15"
                        HeightRequest="48"
                        IsEnabled="{Binding IsNotBusy}"
                        Text="⚡  Generar OTP"
                        TextColor="Black" />
                </VerticalStackLayout>
            </Grid>

            <ActivityIndicator
                HeightRequest="60"
                HorizontalOptions="Center"
                IsRunning="{Binding IsGenerating}"
                IsVisible="{Binding IsGenerating}"
                VerticalOptions="Center"
                WidthRequest="60"
                Color="#00BFFF" />
        </Grid>

        <!--  ══ PANEL 2: Confirmar pallet físico (folio adelantado) ══  -->
        <ScrollView Grid.Row="1" IsVisible="{Binding ShowConfirmarFolio}">
            <VerticalStackLayout Padding="20" Spacing="14">

                <!--  Información de qué se está autorizando  -->
                <Border
                    Padding="16"
                    BackgroundColor="#0D1525"
                    Stroke="#FFB800"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="1.5">
                    <VerticalStackLayout Spacing="6">
                        <Label
                            CharacterSpacing="1"
                            FontSize="11"
                            Text="Solicitud de folio adelantado"
                            TextColor="#8AA0BC" />
                        <Label
                            FontAttributes="Bold"
                            FontSize="17"
                            Text="{Binding InfoProducto}"
                            TextColor="White" />
                        <Label
                            FontAttributes="Bold"
                            FontSize="13"
                            Text="{Binding BatchId}"
                            TextColor="#00BFFF" />
                        <BoxView
                            Margin="0,4"
                            HeightRequest="1"
                            Color="#2A3A50" />
                        <Label
                            FontSize="13"
                            Text="{Binding InfoSolicitante}"
                            TextColor="#8AA0BC" />
                        <Label
                            FontSize="12"
                            Text="{Binding MotivoSolicitud}"
                            TextColor="#5A7FA8" />
                    </VerticalStackLayout>
                </Border>

                <!--  Instrucción + cámara para confirmar pallet  -->
                <Label
                    FontAttributes="Bold"
                    FontSize="14"
                    HorizontalOptions="Center"
                    Text="Escanea el pallet físico para confirmar"
                    TextColor="White" />

                <Border
                    BackgroundColor="#000"
                    HeightRequest="260"
                    HorizontalOptions="Center"
                    StrokeShape="RoundRectangle 12"
                    WidthRequest="260">
                    <Grid>
                        <zxing:CameraBarcodeReaderView
                            x:Name="CameraConfirm"
                            BarcodesDetected="OnBarcodesDetected"
                            HorizontalOptions="Fill"
                            IsDetecting="True"
                            VerticalOptions="Fill" />
                        <Border
                            BackgroundColor="Transparent"
                            HeightRequest="190"
                            HorizontalOptions="Center"
                            Stroke="#FFB800"
                            StrokeDashArray="8,4"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="2"
                            VerticalOptions="Center"
                            WidthRequest="190" />
                    </Grid>
                </Border>

                <Label
                    FontSize="12"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    LineBreakMode="WordWrap"
                    Text="{Binding InstruccionConfirmar}"
                    TextColor="#8AA0BC" />

                <!--  Pallet verificado  -->
                <Border
                    Padding="14"
                    BackgroundColor="#091F09"
                    IsVisible="{Binding PalletVerificado}"
                    Stroke="#0F6E56"
                    StrokeShape="RoundRectangle 10"
                    StrokeThickness="1.5">
                    <Label
                        FontAttributes="Bold"
                        FontSize="14"
                        HorizontalOptions="Center"
                        Text="{Binding PalletVerificadoTexto}"
                        TextColor="#00FF88" />
                </Border>

                <ActivityIndicator
                    HorizontalOptions="Center"
                    IsRunning="{Binding IsGenerating}"
                    IsVisible="{Binding IsGenerating}"
                    Color="#00BFFF" />

                <Button
                    BackgroundColor="#1E2A3A"
                    Command="{Binding ResetScanCommand}"
                    CornerRadius="10"
                    FontSize="14"
                    HeightRequest="44"
                    Text="Cancelar"
                    TextColor="#8AA0BC" />
            </VerticalStackLayout>
        </ScrollView>

        <!--  ══ PANEL 3: OTP generado ══  -->
        <ScrollView Grid.Row="1" IsVisible="{Binding ShowOTP}">
            <VerticalStackLayout
                Padding="20"
                Spacing="16"
                VerticalOptions="Center">

                <!--  Info del lote autorizado  -->
                <Border
                    Padding="16"
                    BackgroundColor="#0D1525"
                    Stroke="#1E3050"
                    StrokeShape="RoundRectangle 12">
                    <Grid
                        ColumnDefinitions="80,*"
                        RowDefinitions="Auto,Auto,Auto"
                        RowSpacing="6">
                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            FontSize="13"
                            Text="Lote:"
                            TextColor="#5A7FA8" />
                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            FontAttributes="Bold"
                            FontSize="14"
                            Text="{Binding BatchId}"
                            TextColor="#00BFFF" />
                        <Label
                            Grid.Row="1"
                            Grid.Column="0"
                            FontSize="13"
                            IsVisible="{Binding EsFolioAdelantado}"
                            Text="Folio:"
                            TextColor="#5A7FA8" />
                        <Label
                            Grid.Row="1"
                            Grid.Column="1"
                            FontSize="13"
                            IsVisible="{Binding EsFolioAdelantado}"
                            Text="{Binding EmbFolio}"
                            TextColor="White" />
                        <Label
                            Grid.Row="2"
                            Grid.Column="0"
                            FontSize="13"
                            IsVisible="{Binding EsFolioAdelantado}"
                            Text="Para:"
                            TextColor="#5A7FA8" />
                        <Label
                            Grid.Row="2"
                            Grid.Column="1"
                            FontSize="12"
                            IsVisible="{Binding EsFolioAdelantado}"
                            LineBreakMode="TailTruncation"
                            Text="{Binding InfoSolicitante}"
                            TextColor="White" />
                    </Grid>
                </Border>

                <!--  OTP grande  -->
                <Border
                    Padding="24,20"
                    BackgroundColor="#0A1525"
                    Stroke="#00BFFF"
                    StrokeShape="RoundRectangle 20"
                    StrokeThickness="2.5">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="8">
                        <Label
                            CharacterSpacing="2"
                            FontSize="11"
                            HorizontalOptions="Center"
                            Text="CÓDIGO OTP — DÍCTALO EN VOZ ALTA"
                            TextColor="#5A7FA8" />
                        <Label
                            CharacterSpacing="12"
                            FontAttributes="Bold"
                            FontSize="80"
                            HorizontalOptions="Center"
                            Text="{Binding OtpCode}"
                            TextColor="#00FF88" />
                        <Label
                            FontSize="12"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            Text="El operador de embarques lo escribe en su terminal"
                            TextColor="#5A7FA8" />
                    </VerticalStackLayout>
                </Border>

                <!--  Countdown  -->
                <Border
                    Padding="16,12"
                    BackgroundColor="#0D1525"
                    Stroke="#FF2D55"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="1.5">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Grid.Column="0"
                            FontSize="16"
                            Text="Expira en:"
                            TextColor="#AAA"
                            VerticalOptions="Center" />
                        <Label
                            Grid.Column="1"
                            FontAttributes="Bold"
                            FontSize="44"
                            Text="{Binding CountdownText}"
                            TextColor="#FF2D55"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Button
                    BackgroundColor="#1E3050"
                    Command="{Binding ResetScanCommand}"
                    CornerRadius="10"
                    FontSize="15"
                    HeightRequest="48"
                    Text="🔄  Escanear Nuevo Lote"
                    TextColor="White" />
            </VerticalStackLayout>
        </ScrollView>

        <!--  Bottom bar  -->
        <Border
            Grid.Row="2"
            Padding="15,8"
            BackgroundColor="#0A0E1A">
            <Label
                FontSize="11"
                HorizontalOptions="Center"
                Text="Código único · Expira en 30 s · Vinculado al lote"
                TextColor="#2A4060" />
        </Border>
    </Grid>
</ContentPage>

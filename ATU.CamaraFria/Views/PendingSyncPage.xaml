<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ATU.CamaraFria.Views.PendingSyncPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Pendientes"
    Padding="{OnPlatform iOS='0,36,0,0',
                         Default='0'}"
    BackgroundColor="#070B18">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!--  RESUMEN  -->
        <Border
            Margin="16,12,16,0"
            Padding="16"
            BackgroundColor="#0D1525"
            StrokeShape="RoundRectangle 16"
            StrokeThickness="0">

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">

                <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                    <Label
                        x:Name="LblTotalPendientes"
                        FontAttributes="Bold"
                        FontSize="28"
                        Text="0"
                        TextColor="#FFB800" />
                    <Label
                        FontSize="11"
                        Text="Pendientes"
                        TextColor="#6A8FB0" />
                </VerticalStackLayout>

                <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                    <Label
                        x:Name="LblFallidos"
                        FontAttributes="Bold"
                        FontSize="28"
                        Text="0"
                        TextColor="#FF5E5E" />
                    <Label
                        FontSize="11"
                        Text="Fallidos"
                        TextColor="#6A8FB0" />
                </VerticalStackLayout>

                <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                    <Label
                        x:Name="LblConexion"
                        FontAttributes="Bold"
                        FontSize="16"
                        Text="—"
                        TextColor="#6A8FB0" />
                    <Label
                        FontSize="11"
                        Text="Red"
                        TextColor="#6A8FB0" />
                </VerticalStackLayout>

            </Grid>
        </Border>

        <!--  BOTÓN PRINCIPAL  -->
        <Button
            x:Name="BtnSync"
            Grid.Row="1"
            Margin="16,12"
            BackgroundColor="#00BFFF"
            Clicked="OnSincronizar"
            CornerRadius="16"
            FontAttributes="Bold"
            FontSize="17"
            HeightRequest="52"
            Text="Sincronizar ahora"
            TextColor="Black">

            <Button.Shadow>
                <Shadow
                    Brush="#00000040"
                    Opacity="0.25"
                    Radius="6"
                    Offset="0,3" />
            </Button.Shadow>
        </Button>

        <!--  LISTA  -->
        <CollectionView
            x:Name="ListaPendientes"
            Grid.Row="2"
            Margin="16,0"
            SelectionMode="None">

            <!--  EMPTY  -->
            <CollectionView.EmptyView>
                <VerticalStackLayout
                    HorizontalOptions="Center"
                    Spacing="6"
                    VerticalOptions="Center">

                    <Label FontSize="40" Text="✅" />
                    <Label
                        FontSize="14"
                        Text="No hay elementos pendientes"
                        TextColor="#6A8FB0" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <!--  ITEMS  -->
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border
                        Margin="0,6"
                        Padding="12"
                        BackgroundColor="#0D1525"
                        StrokeShape="RoundRectangle 14"
                        StrokeThickness="0">

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">

                            <!--  ICONO  -->
                            <Label
                                Grid.Column="0"
                                FontSize="18"
                                Text="{Binding TipoIcono}"
                                VerticalOptions="Center" />

                            <!--  CONTENIDO  -->
                            <VerticalStackLayout Grid.Column="1" Spacing="2">

                                <Label
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    Text="{Binding TipoTexto}"
                                    TextColor="White" />

                                <Label
                                    FontSize="11"
                                    Text="{Binding CreatedAt, StringFormat='Creado: {0:dd/MM HH:mm}'}"
                                    TextColor="#6A8FB0" />

                                <Label
                                    FontSize="11"
                                    IsVisible="{Binding TieneError}"
                                    Text="{Binding ErrorMessage}"
                                    TextColor="#FF5E5E" />

                            </VerticalStackLayout>

                            <!--  RETRY  -->
                            <Label
                                Grid.Column="2"
                                FontSize="11"
                                Text="{Binding RetryCount, StringFormat='#{0}'}"
                                TextColor="#6A8FB0"
                                VerticalOptions="Center" />

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <!--  FOOTER  -->
        <Label
            Grid.Row="3"
            Margin="16,8"
            FontSize="10"
            HorizontalOptions="Center"
            Text="Se sincronizan automáticamente al detectar conexión"
            TextColor="#3A5070" />

    </Grid>
</ContentPage>
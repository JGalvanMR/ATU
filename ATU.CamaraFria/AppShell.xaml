<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ATU.CamaraFria.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ATU.CamaraFria.Views"
    BackgroundColor="#070B18"
    FlyoutBehavior="Disabled">

    <Shell.FlyoutHeader>
        <!--  Sin flyout  -->
    </Shell.FlyoutHeader>

    <TabBar
        BackgroundColor="#0a0e1a"
        Route="MainTab"
        SelectedTabColor="#00BFFF"
        UnselectedTabColor="#666">

        <ShellContent
            Title="Escanear"
            ContentTemplate="{DataTemplate views:OTPDisplayPage}"
            Icon="scan_icon.svg"
            Route="Scan" />

        <ShellContent
            Title="Pendientes"
            ContentTemplate="{DataTemplate views:PendingSyncPage}"
            Icon="sync_icon.svg"
            Route="Pending" />

        <ShellContent
            Title="Configuración"
            ContentTemplate="{DataTemplate views:SettingsPage}"
            Icon="settings_icon.svg"
            Route="Settings" />
    </TabBar>

</Shell>
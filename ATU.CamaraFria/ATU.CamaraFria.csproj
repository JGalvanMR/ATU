<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net9.0-android</TargetFrameworks>
		<RootNamespace>ATU.CamaraFria</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<OutputType>Exe</OutputType>
		
		<ApplicationTitle>ATU Cámara Fría</ApplicationTitle>
		<ApplicationId>com.mrlucky.atu.camarafria</ApplicationId>
		<ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>

		<AndroidPackageFormat>apk</AndroidPackageFormat>
		<AndroidManifestMerger>manifestmerger.jar</AndroidManifestMerger>
		<Platforms>AnyCPU</Platforms>
		<NoWarn>NU1605</NoWarn>
		<NuGetAudit>False</NuGetAudit>
		<PlatformTarget>x64</PlatformTarget>
		<AndroidSigningKeyStore>Keystore\GABIRA.keystore</AndroidSigningKeyStore>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<AndroidLinkMode>None</AndroidLinkMode>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net9.0-android|AnyCPU'">
	  <IsTrimmable>True</IsTrimmable>
	  <AndroidKeyStore>True</AndroidKeyStore>
	  <AndroidSigningStorePass>GABIRA</AndroidSigningStorePass>
	  <AndroidSigningKeyAlias>GABIRA</AndroidSigningKeyAlias>
	  <AndroidSigningKeyPass>GABIRA</AndroidSigningKeyPass>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net9.0-android|AnyCPU'">
	  <IsTrimmable>True</IsTrimmable>
	  <AndroidKeyStore>True</AndroidKeyStore>
	  <AndroidSigningStorePass>GABIRA</AndroidSigningStorePass>
	  <AndroidSigningKeyAlias>GABIRA</AndroidSigningKeyAlias>
	  <AndroidSigningKeyPass>GABIRA</AndroidSigningKeyPass>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="Resources\AppIcon\appicon.svg" />
		<None Remove="Resources\AppIcon\appiconfg.svg" />
	</ItemGroup>

	<ItemGroup>
		<MauiFont Include="Resources\AppIcon\appiconfg.svg" />
	</ItemGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" />
	</ItemGroup>

	<ItemGroup>
		<MauiImage Include="Resources\Images\scan_icon.svg" />
	</ItemGroup>
	<ItemGroup>
		<MauiImage Include="Resources\Images\settings_icon.svg" />
	</ItemGroup>
	<ItemGroup>
		<MauiImage Include="Resources\Images\sync_icon.svg" />
	</ItemGroup>

	<ItemGroup>
		<!-- MAUI para .NET 9 -->
		<PackageReference Include="Microsoft.Maui.Controls" Version="9.0.82" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="9.0.82" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.0" />

		<!-- Biometría -->
		<PackageReference Include="Plugin.Maui.Biometric" Version="0.0.9" />

		<!-- Escáner QR (versiones compatibles con .NET 9) -->
		<PackageReference Include="ZXing.Net.Maui" Version="0.4.0" />
		<PackageReference Include="ZXing.Net.Maui.Controls" Version="0.4.0" />

		<!-- SQLite -->
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.0" />

		<!-- HTTP Client (Refit ya está bien) -->
		<PackageReference Include="Refit" Version="8.0.0" />
		<PackageReference Include="Refit.HttpClientFactory" Version="8.0.0" />

		<!-- SignalR Client (actualizar a 9.0.0) -->
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="9.0.0" />

		<!-- MVVM Toolkit -->
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
	</ItemGroup>

	<ItemGroup>
        <ProjectReference Include="..\ATU.Shared\ATU.Shared.csproj" />
    </ItemGroup>

	<ItemGroup>
		<MauiXaml Update="Views\PendingSyncPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Views\SettingsPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Views\SolicitudesPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
	</ItemGroup>

</Project>